---
const isFrench = Astro.currentLocale === 'fr';
const localePrefix = isFrench ? '/fr' : '';
const pathname = Astro.url.pathname;
const englishPath = pathname.replace(/^\/fr(?=\/|$)/, '') || '/';
const translatedPaths = new Set(['/', '/blog/', '/poetry/']);
const frenchPath = isFrench
    ? pathname
    : translatedPaths.has(pathname)
        ? pathname === '/' ? '/fr/' : `/fr${pathname}`
        : '/fr/blog/';

const labels = isFrench
    ? {home: 'Accueil', blog: 'Blog'}
    : {home: 'Home', blog: 'Blog'};

const title = isFrench
    ? {title: "Salut, je m'appelle Matt."}
    : {title: "Hi, I'm Matt."}
---
<script src="https://kit.fontawesome.com/1f927a0858.js" crossorigin="anonymous"></script>

<h1 class="split-header">
    <!-- TODO: Change the salutation/welcome to be thel ink to home -->
    <span id="name">{title.title}</span>
    <span id="links">
    <a class="link" href={`${localePrefix}/`}>{labels.home}</a>
    <a class="link" href={`${localePrefix}/blog/`}>{labels.blog}</a>
    
    <span id="socials">
      <a href="https://www.youtube.com/@mttylbrq" aria-label="YouTube">
        <i class="fa-brands fa-youtube"></i>
        <span class="sr-only">YouTube</span>
      </a>
      <a href="https://x.com/mhlvswrld" aria-label="X">
        <i class="fa-brands fa-x-twitter"></i>
        <span class="sr-only">X</span>
      </a>
      <a href="https://github.com/mattheenan" aria-label="GitHub">
        <i class="fa-brands fa-github"></i>
        <span class="sr-only">GitHub</span>
      </a>


    </span>

    <span id="language-switcher" role="navigation" aria-label={isFrench ? 'Choisir la langue' : 'Choose language'}>
      <a class="link" href={englishPath} lang="en" hreflang="en" aria-current={!isFrench ? 'page' : undefined}>EN</a>
      <span aria-hidden="true">/</span>
      <a class="link" href={frenchPath} lang="fr" hreflang="fr" aria-current={isFrench ? 'page' : undefined}>FR</a>
    </span>
  </span>
</h1>

<style>
    .split-header {

        display: flex;
        justify-content: space-between;
        align-items: center;
        vertical-align: middle;
        width: 100%;
    }

    #name {
        text-align: center;
        letter-spacing: 7px;
    }

    #links {
        vertical-align: middle;
    }

    #socials {
        all: unset;
        display: inline-flex;
        gap: 0.4rem;
    }

    #socials a {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
    }

    #language-switcher {
        display: inline-flex;
        align-items: center;
        gap: 0.15rem;
        margin-left: 0.4rem;
        font-size: 0.85rem;
    }

    #language-switcher .link {
        padding-inline: 0.2rem;
    }

    #language-switcher [aria-current="page"] {
        color: #abb2bf;
        cursor: default;
        text-decoration: none;
    }

    .link {
        color: #88af6c;
        cursor: pointer;
        text-decoration: underline;
    }

    .link:hover {
        color: #E5C07B;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
    }

</style>
