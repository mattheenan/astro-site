---
import Header from "../../components/Header.astro"
import "../../styles/global.css"
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});
---

<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <title>Blogue de Matt Labrecque</title>
  </head>
  <body>
    <Header />
  <p>Les divagations et réflexions d’un mathématicien et informaticien originaire du nord de la Nouvelle-Angleterre.</p>

    <section>
      <h2>Articles récents</h2>
      <ul>
        {sortedPosts.map((post) => (
            <li>
              <a href={`${import.meta.env.BASE_URL}posts/${post.id}/`}>{post.data.title}</a>
            </li>
        ))}
      </ul>
    </section>
  </body>
</html>
