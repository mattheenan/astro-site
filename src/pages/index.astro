---
import Header from "../components/Header.astro"
import Project from "../components/Project.astro"
import Education from "../components/Education.astro"
import "../styles/global.css"
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Matt Heenan-Labrecque</title>
</head>
<Header/>

<div class="profile-text">

    <p>I'm a Canadian-American Computer-Science/Applied Mathematics student currently completing his Bachelor's
        Degree at the University of New Hampshire. My interests within CS/Math include systems-programming,
        algorithm analysis, and machine learning. I'm also a creative person, and make both films and movies as
        well as write poetry.

        I like to view myself as a hacker in the old-school vein who uses technology to
        build things and solve interesting problems, as well as pursue the things which I find most interesting.
        When I'm not working on my homelab or experimenting with coffee, you usually can find me outside and
        exploring this beautiful planet that we get to call home.</p>

    <p>Contact: <span id="copy-email" class="clickable-email">mlabrecque2002 [at] gmail (dot) com</span></p>

</div>

<hr class="solid">

<div>

    <h2>Projects</h2>
    <div class="project-grid">

        <Project
                title="Billboard Top-40 Lookup"
                description="I DJ for fun at my college radio station (91.3FM WUNH) and our specialty is we only play music which has not charted in the Top 40 on the
        Billboard Hot 100 charts. However there wasn't any easy way to determine if a song had charted or not. I solved this by writing a small Python program 
        which automates the retrieval of Billboard data and allows someone to querry it for artist and song data."
                tags={["Python", "Data Processing", "Data Analytics"]}
        />

        <Project
                title="AI Music Detection Software"
                description="With the rise of Suno and other so called computer-generated music "
                tags={["Machine Learning", "Python", "Fourier Transformations"]}
        />

        <Project
                title="Gostow"
                descrption="I always liked the idea behind GNU Stow, but my biggest problem with it was the fact that it
                was a general purpose utility and not designed specifically for dotfile management. I wrote Gostow as a
                replacement which specializes in only dotfile management, written entirely in Golang."
                tags={["Go"]}
        />

        <Project
                title="Machine Learning Coffee"
                descrption="My Senior project"
                tags={["Machine Learning", "Python", "Linear Algebra"]}
        />

        <Project
                title="Homelab"
                description="Over the last several months I have worked on designing and building a four-node Kubernetes cluster homelab for self-hosting my
					   media collection as well as personal projects. The homelab is composed of three Lenovo ThinkCentre M90q computers serving as worker
					   nodes, and a Raspberry Pi 5 which serves as the control node. Some services I run in this cluster include PiHole for custom DNS 
					   blocking, Jellyfin for manging music/movies, a private Forgejo instance for Git projects which I don't want to be publically hosted,
					   Nextcloud to provide cloud storage/backups which utilizes an 8TB NAS for mass storage, and FreshRSS for media consumption."
                tags={["Kubernetes", "System Administration", "Linux"]}
        />

        <Project
                title="Zettk-CLI"
                description="A CLI tool I developed to help with my note taking system (that being the Zettlekasten system popularized by Leibniz)
		       without the need for external GUI tools such as Obsidian. It worked by auto creating and linking notes together as I
		       create them, building the web of notes as I learn. This system hooks directly into your Neovim configuration as well,
		       enabling a fast, dynamic workflow of note taking that prioritizes getting knowledge down without the hassle of using
		       a GUI application."
                tags={["Go", "CLI"]}
        />
    </div>

    <hr class="solid">

    <Education/>

    <script>
        const emailSpan = document.getElementById('copy-email');
        const originalText = emailSpan.textContent;
        emailSpan.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText('mlabrecque2002@gmail.com');
                emailSpan.textContent = 'Copied!';
                setTimeout(() => {
                    emailSpan.textContent = originalText;
                }, 1500);
            } catch (err) {
                console.error('Failed to copy:', err);
            }
        });
    </script>
</div>
<style>

    .profile-text {
        flex: 1;
        vertical-align: middle;
    }

    .project-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-around;
    }

    .clickable-email {
        color: #88af6c;
        cursor: pointer;
        text-decoration: underline;
    }

    .clickable-email:hover {
        color: #E5C07B;
    }

</style>
